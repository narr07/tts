# Better Auth: isi dengan string acak minimal 32 karakter, misalnya hasil `openssl rand -base64 32`
NUXT_BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Opsional: sandi admin saat menjalankan scripts/seed_edu.ts atau scripts/export_d1.ts
# SEED_ADMIN_PASSWORD=

# Cloudflare Pages: ID database D1 dari `bunx wrangler d1 create petualangan-kata-sd`.
# Hanya dipakai saat `bun run build:pages`; dev lokal tetap memakai SQLite di .data/db.
NUXT_HUB_D1_DATABASE_ID=
